          \MTmathoperatorsdonotobeymathxx
          \MTnormalexists
          \MTnormalforall
          \MTeverymathoff
          \MTresetnewmcodes
          \mst@subduedhbar
          \mst@subduedinodot
          \mst@subduedmathaccents
          \mst@subduedminus
        \else
